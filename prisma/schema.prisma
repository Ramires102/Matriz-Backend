generator client {
	provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}model Avilability {
	id Int @id @default(autoincrement())
	service Services @relation(fields: [serviceFK], references: [id])
	serviceFK Int
	initDate DateTime @db.Timestamp(0)
	endDate DateTime @db.Timestamp(0)

	@@unique([serviceFK, initDate])
	@@unique([serviceFK, endDate])
}model ChatMembers {
	id Int @id @default(autoincrement())
	chat Chats @relation(fields: [chatFK], references: [id])
	chatFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	isAdmin Boolean?

	@@unique([chatFK, userFK])
}enum Type {
	GROUP
	CHAT
}

model Chats {
	id Int @id @default(autoincrement())
	name String
	image String @default("https://undefined.com") //Acá hay que poener la URL a la imágen por default de Cloudinary (o sea, una cosa gris con un dibujito sensillo).
	type Type @default(CHAT)
	addMembers Boolean @default(true)
	sendMessages Boolean @default(true)
	approveNewMembers Boolean @default(false)
	event Events @relation(fields: [eventId], references: [id])
	eventId Int
	destroyAfterEvent Boolean @default(true)
	membersAmount Int @default(2)
	messages Messages[]
	chatMembersRel ChatMembers[]
}model CommentLikes {
	id Int @id @default(autoincrement())
	comment Comment @relation(fields: [commentFK], references: [id])
	commentFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
}model Comment {
	id Int @id @default(autoincrement())
	post Posts @relation(fields: [postFK], references: [id])
	postFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	text String?
	image String?
	likesCount Int @default(0)
	createdAt DateTime @db.Timestamp(3)
	commentLikesRel CommentLikes[]
}enum ContratsPayState {
	PENDING
	APPROVED
	PROCESSING
	REJECTED
}

model Contrats {
	id Int @id @default(autoincrement())
	event Events @relation(fields: [eventFK], references: [id])
	eventFK Int
	service Services @relation(fields: [serviceFK], references: [id])
	serviceFK Int
	paymentState ContratsPayState
}model EventCategories {
	id Int @id @default(autoincrement())
	name String @unique
	deletedAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	eventsRel Events[]
}model EventRating {
	id Int @id @default(autoincrement())
	rate Int
	event Events @relation(fields: [eventFK], references: [id])
	eventFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int

	@@unique([eventFK, userFK])
}model Events {
	id Int @id @default(autoincrement())
	owner User @relation(fields: [userFK], references: [id])
	userFK Int
	name String
	description String?
	image String @default("https://undefined.com")
	initDate DateTime @db.Timestamp
	endingDate DateTime? @db.Timestamp
	location String
	open Boolean @default(false)
	category EventCategories @relation(fields: [categoryFK], references: [id])
	categoryFK Int
	ticketPrice Int
	rate Int @default(-1)
	deletedAt DateTime?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	postsRel Posts[]
	guestsRel Guests[]
	eventsRatingRel EventRating[]
	contractsRel Contrats[]
	chatsRel Chats[]
}enum GuestsPayState {
	NOT_REQUIRED
	PENDING
	APPROVED
	PROCESSING
	REJECTED
}

model Guests {
	id Int @id @default(autoincrement())
	event Events @relation(fields: [eventFK], references: [id]) 
	eventFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	paymentState GuestsPayState @default(NOT_REQUIRED)

	@@unique([eventFK, userFK])
}

model Messages {
	id Int @id @default(autoincrement())
	chat Chats @relation(fields: [chatFK], references: [id])
	chatFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	text String?
	image String?
	reactions Json @db.JsonB
	seen Boolean @default(false)
	createdAt DateTime @db.Timestamp(0)
	updatedAt DateTime @db.Timestamp(0)
	seens Seens[]
	reactionsRel Reactions[]
}model PostsAnalytics {
	id Int @id @default(autoincrement())
	post Posts @relation(fields: [postFK], references: [id])
	postFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	liked Boolean @default(false)
	commented Boolean @default(false)
	shared Boolean @default(false)
	favourite Boolean @default(false)
	dwellTime Int
	completionRate Int
	notInterested Boolean @default(false)
	finalRate Int
}model Posts {
	id Int @id @default(autoincrement())
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	text String?
	media Json? @db.JsonB
	ubication String?
	isAdd Boolean @default(false)
	likesCount Int @default(0)
	sharesCount Int @default(0)
	favouritesCount Int @default(0)
	commentsCount Int @default(0)
	restrictedComments Boolean @default(false)
	sourceIp String
	event Events @relation(fields: [eventFK], references: [id])
	eventFK Int
	rate Int
	interactions Int
	taggedRel Tagged[]
	postsAnalyticsRel PostsAnalytics[]
	commentsRel Comment[]
}model Reactions {
	id Int @id @default(autoincrement())
	messages Messages @relation(fields: [messagesFK], references: [id])
	messagesFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	emoji String @db.Char(1)
}model Seens {
	id Int @id @default(autoincrement())
	user User @relation(fields: [userFK], references: [id])
	userFK Int
	message Messages @relation(fields: [messageFK], references: [id])
	messageFK Int

	@@unique([userFK, messageFK])
}model ServiceRating {
	id Int @id @default(autoincrement())
	rate Int
	service Services @relation(fields: [serviceFK], references: [id])
	serviceFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int

	@@unique([serviceFK, userFK])
}model ServiceCategories { 
	id Int @id @default(autoincrement())
	name String @unique
	serviceRel Services[]
}enum PayType {
	PER_HOUR
	PER_SERVICE
	PER_PERSON
	PER_UNIT
	COMPLETE
}

enum ResType {
	HOME
	NO_HOME
	CLOUDE
}

model Services {
	id Int @id @default(autoincrement())
	provider User @relation(fields: [userFK], references: [id])
	userFK Int
	name String
	description String
	ubication String?
	sourceUbication String?
	category ServiceCategories @relation(fields: [categoryFK], references: [id])
	categoryFK Int
	coberRadius Int
	basePrice Int
	paymentType PayType
	receptionType ResType
	details Json? @db.JsonB
	rating Int @default(0)
	serviceRatingRel ServiceRating[]
	contractsRel Contrats[]
	avilabilityRel Avilability[]
}model Tagged {
	id Int @id @default(autoincrement())
	post Posts @relation(fields: [postFK], references: [id])
	postFK Int
	user User @relation(fields: [userFK], references: [id])
	userFK Int
}enum Role {
	ADMIN
	CONSUMER //usuario común, consumidor de servicios y eventos
	ORGANIZATOR //organiza eventos, pero no ofrece servicios
	OFFERER //ofrece servicios, puede organiza eventos (opcional)
}

model User {
	id Int @id @default(autoincrement())
	role Role @default(CONSUMER)
	user String @unique
	name String
	password String
	email String @unique
	verified Boolean @default(false)
	image String @default("https://undefined.com") //Acá hay que poener la URL a la imágen por default de Cloudinary (o sea, una cosa gris con un dibujito sensillo).
	dni String? @unique
	cuit String? @unique 
	address String?
	serviceFK Int?
	taggedRel Tagged[]
	serviceRel Services[]
	serviceRatingRel ServiceRating[]
	seensRel Seens[]
	reactionsRel Reactions[]
	postAnalyticsRel PostsAnalytics[]
	postsRel Posts[]
	messagesRel Messages[]
	guestsRel Guests[]
	eventsRel Events[]
	enventsRatingRel EventRating[]
	commentLikesRel CommentLikes[]
	commentsRel Comment[]
	chatMembersRel ChatMembers[]
}